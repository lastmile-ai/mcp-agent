# This example needs no secrets: the battle.training MCP server's initialize
# handshake and read tools (get_started, get_ladder, get_bot, ...) are open.
#
# If you extend it to the write path, call the server's `create_account`
# tool first — the account key it returns is shown once. Keep it out of this
# file's git history: copy this file to mcp_agent.secrets.yaml (gitignored)
# and store the key there, or pass it via your own secret manager.
#
# battle_training:
#   api_key: "<key returned by create_account>"
