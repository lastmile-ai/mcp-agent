$schema: ../../../schema/mcp-agent.config.schema.json

# Copy this file to mcp_agent.secrets.yaml and fill in your LLM provider key.
# mcp_agent.secrets.yaml should be gitignored.
#
# NOTE: There is NO Unstructured credential here. The Transform MCP server is
# authenticated via browser-based OAuth (configured in mcp_agent.config.yaml);
# on first run a browser opens and you sign in -- no API key to paste.

openai:
  api_key: "sk-your-openai-key"

anthropic:
  api_key: "sk-your-anthropic-key"
